clc;
clear;
close all;
s = tf('s');

G = 200/(s*(s+2)*(s+10));

Kv = dcgain(s*G)

zeta = -log(0.2)/sqrt(pi^2 + log(0.2)^2);
PM = atan(2*zeta/sqrt(sqrt(1+4*zeta^4)-2*zeta^2))*180/pi

figure;
margin(G);
grid on;

w = logspace(-2,3,10000);
[mag,phase] = bode(G,w);
mag = squeeze(mag);
phase = squeeze(phase);

PM_req = PM + 10;
phase_req = -180 + PM_req;

figure;
subplot(2,1,1);
semilogx(w,20*log10(mag));
grid on;


subplot(2,1,2);
semilogx(w,phase);
hold on;

grid on;
w_new = 0.64;
M_dB = 23.7;
beta = 10^(M_dB/20);

wz = w_new/4;
wp = wz/beta;

wz = w_new/4;
wp = wz/beta;

Gc = (s/wz+1)/(s/wp+1);
Gf = G*Gc;

figure;
bode(G,Gc,Gf);
grid on;
legend('Uncompensated','Lag compensator','Compensated');

[GM,PM1,Wcg,Wcp] = margin(Gf);
GM_dB = 20*log10(GM)

figure;
margin(Gf);
grid on;

Tf = feedback(Gf,1);

figure;
step(Tf);
grid on;

figure;
bode(Tf);
grid on;

stepinfo(Tf)

Kv_comp = dcgain(s*Gf)

[num,den] = tfdata(Tf,'v');
num_step = num;
den_step = conv(den,[1 0]);
[r,p,k] = residue(num_step,den_step)


disp(r);

disp(p);

disp(k);
