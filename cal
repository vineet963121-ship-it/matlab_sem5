clear; clc; close all;

K = 200;
s = tf('s');
G = K / (s * (s + 2) * (s + 10));

OS = 0.20;
zeta = sqrt((log(OS))^2 / (pi^2 + (log(OS))^2));
PM_req = atan(2 * zeta / sqrt(sqrt(1 + 4*zeta^2) - 2*zeta^2)) * (180/pi);

PM_des = PM_req + 6;
target_phase = -180 + PM_des;

w = logspace(-2, 3, 5000);
[mag, phase] = bode(G, w);
mag = squeeze(mag);
phase = squeeze(phase);

[~, idx] = min(abs(phase - target_phase));
w_gc_new = w(idx);
mag_at_w_gc = mag(idx);

beta = mag_at_w_gc;
w_z = 0.1 * w_gc_new;
w_p = w_z / beta;

D_lag = (1 + s / w_z) / (1 + s / w_p);
G_comp = D_lag * G;

[Gm, Pm, Wcg, Wcp] = margin(G_comp);
Gm_dB = 20 * log10(Gm);

T_comp = feedback(G_comp, 1);
[r, p, ~] = residue(T_comp.Numerator{1}, T_comp.Denominator{1});

